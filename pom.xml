<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
    Proporciona versiones compatibles y configuraciones
    predeterminadas para las dependencias de Spring Boot.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath />
    </parent>

    <!-- Identificación del proyecto Maven. -->
    <groupId>co.edu.sena.rfid</groupId>
    <artifactId>rfid-categoria-activo-spring</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>RFIDCategoriaActivoSpring</name>

    <description>
        API REST para gestionar categorías de activos
        del Sistema RFID de Gestión de Activos.
    </description>

    <!-- Configuración general del proyecto. -->
    <properties>
        <java.version>21</java.version>

        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <project.reporting.outputEncoding>
            UTF-8
        </project.reporting.outputEncoding>

        <start-class>
            co.edu.sena.rfid.RfidCategoriaActivoSpringApplication
        </start-class>
    </properties>

    <dependencies>

        <!--
        Permite crear controladores REST con Spring MVC
        e incluye el servidor Tomcat integrado.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
        Proporciona persistencia mediante Jakarta Persistence,
        Hibernate y repositorios de Spring Data JPA.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
        Activa las anotaciones de validación utilizadas
        en los datos recibidos por la API.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Controlador JDBC para la conexión con MySQL. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
        Facilita el desarrollo mediante reinicio automático.
        Es opcional y no forma parte obligatoria del JAR final.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!--
        Incluye JUnit y herramientas de prueba
        para aplicaciones Spring Boot.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>

        <!-- Nombre del archivo JAR generado por Maven. -->
        <finalName>
            RFIDCategoriaActivoSpring
        </finalName>

        <plugins>

            <!--
            Empaqueta la aplicación y sus dependencias
            como un archivo JAR ejecutable.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>

                <configuration>
                    <mainClass>
                        ${start-class}
                    </mainClass>
                </configuration>
            </plugin>

        </plugins>

    </build>

</project>